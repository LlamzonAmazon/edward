{
  "id": "ind-evasivepanda-downloader-path",
  "kind": "indicator",
  "title": "Runs from the same path as Evasive Panda downloader",
  "source": "processes",
  "when": [
    {
      "fact": "Path",
      "is": [
        "~/Library/SafariBrowser/Safari.app/Contents/MacOS/SafariBrower"
      ]
    }
  ],
  "technique": "T1036.005",
  "reports": [
    {
      "name": "Objective-See report on EvasivePanda Downloader",
      "url": "https://objective-see.org/blog/blog_0x7D.html"
    }
  ],
  "added": "2026-11-16",
  "expires": "2028-11-16",
  "tests": {
    "match": [
      {
        "Path": "~/Library/SafariBrowser/Safari.app/Contents/MacOS/SafariBrower"
      }
    ],
    "noMatch": [
      {
        "Path": "/Applications/Example.app/Contents/MacOS/Example"
      }
    ]
  }
}
