{
  "id": "ind-dazzlespy-runs",
  "kind": "indicator",
  "title": "Starts the same program at login as DazzleSpy",
  "source": "startup",
  "when": [
    {
      "fact": "Runs",
      "is": [
        "~/.local/softwareupdate"
      ]
    }
  ],
  "technique": "T1543.001",
  "reports": [
    {
      "name": "ESET report on DazzleSpy",
      "url": "https://www.welivesecurity.com/2022/01/25/watering-hole-deploys-new-macos-malware-dazzlespy-asia/"
    }
  ],
  "added": "2026-11-16",
  "expires": "2028-11-16",
  "tests": {
    "match": [
      {
        "Runs": "~/.local/softwareupdate"
      }
    ],
    "noMatch": [
      {
        "Runs": "/usr/sbin/softwareupdate"
      }
    ]
  }
}
