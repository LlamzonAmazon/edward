        "com.apple.systemupdate"
      ]
    }
  ],
  "technique": "T1543.001",
  "reports": [
    {
      "name": "Elastic Security Labs report on RustBucket",
      "url": "https://www.elastic.co/security-labs/DPRK-strikes-using-a-new-variant-of-rustbucket"
    }
  ],
  "added": "2026-11-16",
  "expires": "2028-11-16",
  "tests": {
    "match": [
      {
        "Label": "com.apple.systemupdate"
      }
    ],
    "noMatch": [
      {
        "Label": "com.example.agent"
      }
    ]
  }
}
